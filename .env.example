OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai-hk.com/v1
MINIMAX_API_KEY=...
MINIMAX_BASE_URL=https://api.minimaxi.com
PACKY_API_KEY=sk-...
PACKY_BASE_URL=https://api-slb.packyapi.com/v1
PROMPT_PORTAL_URL=http://127.0.0.1:8768

# Optional global fallback text channel (画布里仍可再加自定义渠道).
# Key is required to advertise the channel; base URL defaults to OPENAI_BASE_URL.
# TEXT_MODEL is a comma-separated list of model ids shown in the picker.
# TEXT_API_KEY=sk-...
# TEXT_BASE_URL=https://api.openai-hk.com/v1
# TEXT_MODEL=gpt-5.4
# TEXT_API_FORMAT=chat-completions

# Optional unified prompt library storage (defaults: data/prompt-library and ../prompt/backend)
# PROMPT_LIBRARY_DATA_DIR=/path/to/prompt-library
# PROMPT_PORTAL_DATA_DIR=/path/to/prompt/backend
